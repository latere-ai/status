<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Latere Status</title>
<meta name="description" content="Current status and 90-day history of Latere's public services.">
<meta name="color-scheme" content="light dark">
<link rel="preload" href="fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="top">
  <a class="brand" href="https://latere.ai/"><span class="logo">Latere</span></a>
  <span class="page-name">Status</span>
</header>
<main>
  <section class="headline {{.Class}}" aria-live="polite">
    <span class="dot" aria-hidden="true"></span>
    <h1>{{.Headline}}</h1>
  </section>
  {{if .Stale}}<p class="notice">The newest check is more than 30 minutes old. Checks may be delayed, so the states below may be out of date.</p>{{end}}

  {{if .Open}}
  <section aria-labelledby="open-h">
    <h2 id="open-h">Open incidents</h2>
    {{range .Open}}{{template "incident" .}}{{end}}
  </section>
  {{end}}

  <section aria-labelledby="services-h">
    <h2 id="services-h">Services</h2>
    <ul class="services">
      {{range .Services}}
      <li class="service">
        <div class="service-head">
          <span class="service-name">{{.Name}}</span>
          <span class="state {{.Class}}">{{.Label}}</span>
        </div>
        <ol class="bars" aria-label="{{.Name}} daily uptime, last 90 days">
          {{range .Bars}}<li class="bar {{.Class}}" title="{{.Tip}}"></li>{{end}}
        </ol>
        <div class="service-foot"><span>90 days ago</span><span>{{.Uptime}}</span><span>Today</span></div>
      </li>
      {{end}}
    </ul>
    <p class="legend"><span class="key up"></span>Running <span class="key degraded"></span>Some slow or failed checks <span class="key down"></span>Down for a while <span class="key nodata"></span>No data</p>
  </section>

  <section aria-labelledby="past-h">
    <h2 id="past-h">Past incidents</h2>
    {{range .Past}}{{template "incident" .}}{{else}}<p class="muted">No incidents in the past 90 days.</p>{{end}}
  </section>
</main>
<footer class="foot">
  {{if .LastChecked}}<p>Last checked <time datetime="{{.LastCheckedISO}}">{{.LastChecked}}</time>.</p>{{end}}
  <p class="muted">Checks run every 5 minutes from outside Latere's own infrastructure. A service shows as down or degraded after two checks in a row. Times are UTC.</p>
</footer>
</body>
</html>
{{define "incident"}}
<article class="incident">
  <header>
    <h3>{{.Title}}</h3>
    <p class="meta">{{if .Open}}<span class="badge open">Open</span>{{else}}<span class="badge">Resolved</span>{{end}}
      Started <time datetime="{{.StartedISO}}">{{.Started}}</time>{{if .Resolved}}, resolved <time datetime="{{.ResolvedISO}}">{{.Resolved}}</time>{{end}}.
      {{if .Services}}Affected: {{.Services}}.{{end}}</p>
  </header>
  {{range .Paragraphs}}<p>{{.}}</p>{{end}}
  {{if .Updates}}
  <ul class="updates">
    {{range .Updates}}<li><strong>{{.Status}}</strong> <time datetime="{{.ISO}}">{{.Time}}</time><br>{{.Text}}</li>{{end}}
  </ul>
  {{end}}
</article>
{{end}}
